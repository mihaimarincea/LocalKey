/**
 * This Firestore Security Ruleset is designed for the LOCALKEY application,
 * balancing strong user data protection with public accessibility for offers and partners.
 *
 * Core Philosophy:
 * The security model enforces a strict user-ownership pattern for all personal data,
 * such as user profiles, redemption history, and invite codes. Publicly-facing data,
 * like partner and offer listings, is readable by anyone but writeable only by administrators.
 * This ensures data privacy while allowing the app to function as a public catalog.
 *
 * Data Structure:
 * - /users/{userId}: Private user profiles and root for user-owned subcollections.
 * - /users/{userId}/redemptions/{redemptionId}: A user's private offer redemption history.
 * - /users/{userId}/inviteCodes/{inviteCodeId}: Invite codes generated by a user.
 * - /partners/{partnerId}: Publicly readable partner information.
 * - /offers/{offerId}: Publicly readable offer details.
 * - /roles_admin/{userId}: An access control list; the existence of a document
 *   here grants a user administrative privileges across the application.
 *
 * Key Security Decisions:
 * - User Listing Disabled: To protect user privacy, it is not possible to list all
 *   documents in the top-level `/users` collection.
 * - Admin-Managed Public Data: All write operations (create, update, delete) on
 *   the public `/partners` and `/offers` collections are restricted to users with
 *   an admin role.
 * - Path-Based Security: User-specific data is nested under `/users/{userId}`,
 *   allowing for simple and performant rules that grant access based on the user's
 *   authenticated UID matching the path.
 * - Denormalization for Authorization: The rules rely on fields like `userId` being
 *   present on subcollection documents (e.g., Redemption) to enforce path consistency
 *   without needing slow and costly `get()` calls to parent documents.
 * - Structural Segregation: Private user data (redemptions) and public data (offers)
 *   are stored in separate collections, which is more secure and performant than mixing them.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------
    // Helper Functions
    // --------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user's UID matches the provided userId.
     * This is the foundation for the ownership model.
     * @param userId The UID of the document owner.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if the document being accessed already exists in Firestore.
     * Crucial for protecting against writes to non-existent paths.
     */
    function isExistingDoc() {
      return resource != null;
    }

    /**
     * A convenience function for update/delete operations, ensuring the user is
     * the owner of an existing document before allowing the modification.
     * @param userId The UID of the document owner.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && isExistingDoc();
    }
    
    /**
     * Checks if the user has an admin role by verifying the existence of their
     * UID document in the roles_admin collection.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * A convenience function for admin update/delete operations on existing documents.
     */
    function isExistingAdmin() {
      return isAdmin() && isExistingDoc();
    }

    // --------------------------------------------------------------------
    // User Data
    // --------------------------------------------------------------------

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow A signed-in user (auth.uid='user123') can (create) their own profile at /users/user123.
     * @deny A user (auth.uid='user123') cannot (get) another user's profile at /users/user456.
     * @principle Restricts access to a user's own data tree and prevents enumeration of users.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // CRITICAL: Prevent listing all users for privacy.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id && request.resource.data.inviterId == resource.data.inviterId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages user-specific offer redemption records.
     * @path /users/{userId}/redemptions/{redemptionId}
     * @allow A user (auth.uid='user123') can (create) a redemption record at /users/user123/redemptions/abc.
     * @deny An attacker cannot (list) redemptions for another user at /users/user456/redemptions.
     * @principle Enforces path-based ownership for a user's private subcollections.
     */
    match /users/{userId}/redemptions/{redemptionId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId && request.resource.data.offerId == resource.data.offerId && request.resource.data.partnerId == resource.data.partnerId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages invite codes generated by a user.
     * @path /users/{userId}/inviteCodes/{inviteCodeId}
     * @allow A user (auth.uid='user123') can (list) their own invite codes at /users/user123/inviteCodes.
     * @deny A user (auth.uid='user123') cannot (delete) invite codes for /users/user456/inviteCodes/xyz.
     * @principle Enforces path-based ownership for a user's private subcollections.
     */
    match /users/{userId}/inviteCodes/{inviteCodeId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.inviterId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.inviterId == resource.data.inviterId && request.resource.data.code == resource.data.code;
      allow delete: if isExistingOwner(userId);
    }

    // --------------------------------------------------------------------
    // Public Data (Admin-Managed)
    // --------------------------------------------------------------------

    /**
     * @description Controls access to partner organization profiles.
     * @path /partners/{partnerId}
     * @allow Any user, signed-in or not, can (get) or (list) partner information.
     * @deny A non-admin user cannot (create), (update), or (delete) a partner.
     * @principle Allows public read access for catalog data while restricting writes to trusted admins.
     */
    match /partners/{partnerId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update, delete: if isExistingAdmin();
    }

    /**
     * @description Controls access to public offers.
     * @path /offers/{offerId}
     * @allow Any user, signed-in or not, can (get) or (list) offer information.
     * @deny A non-admin user cannot (create) an offer.
     * @principle Allows public read access for catalog data while restricting writes to trusted admins.
     */
    match /offers/{offerId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isExistingAdmin() && request.resource.data.partnerId == resource.data.partnerId;
      allow delete: if isExistingAdmin();
    }

    // --------------------------------------------------------------------
    // Administrative Roles
    // --------------------------------------------------------------------

    /**
     * @description Secures the admin role definitions.
     * @path /roles_admin/{userId}
     * @allow An admin user can (list) other admins.
     * @deny A regular user cannot (create) a document for themselves to become an admin.
     * @principle Secures role-granting actions. Only existing admins can modify roles.
     */
    match /roles_admin/{userId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isExistingAdmin();
    }
  }
}