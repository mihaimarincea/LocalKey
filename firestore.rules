rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    function isPartner() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_partner/$(request.auth.uid));
    }

    // -------------------------------------------------------------------------
    // User Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      // Admins can read any user doc. Users can read their own.
      allow get: if isOwner(userId) || isAdmin();
      
      // Admins can update any user doc. Users can update their own.
      allow update: if isOwner(userId) || isAdmin();
      
      // Only admins can delete user documents.
      allow delete: if isAdmin();

      // Sub-collections
      match /redemptions/{redemptionId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isPartner()) && request.resource.data.userId == userId;
        allow update, delete: if isAdmin();
      }

      match /invite_codes/{inviteCodeId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && request.resource.data.inviterId == userId;
        allow update, delete: if isAdmin();
      }
    }
    
    // Grant list permission for the entire /users collection to admins
    match /users {
      allow list: if isAdmin();
      // Allow any signed-in user to create their own user document
      allow create: if isSignedIn() && request.resource.data.id == request.auth.uid;
    }


    // -------------------------------------------------------------------------
    // Public and Partner-facing Collections
    // -------------------------------------------------------------------------

    match /partners/{partnerId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /offers/{offerId} {
      allow get, list: if true;
      allow create: if (isAdmin() || isPartner());
      // A partner can only update/delete offers they own. Admins can do anything.
      allow update, delete: if isAdmin() || (isPartner() && resource.data.partnerId == request.auth.uid);
    }
    
    // -------------------------------------------------------------------------
    // Role Management Rules
    // -------------------------------------------------------------------------

    match /roles_admin/{uid} {
      // Only other admins can see or edit who is an admin.
      allow read, write: if isAdmin();
    }
    
    match /roles_partner/{uid} {
      // Only admins can manage the partner role.
      allow read, write: if isAdmin();
    }
  }
}
