/**
 * @file firestore.rules
 * @description Firestore Security Rules for the LocalKey application.
 *
 * @section Core Philosophy
 * This ruleset enforces a security model that strictly separates public business data from private user data.
 * It uses a combination of user ownership and a global admin role to control access. The primary goal is high security
 * and authorization integrity while allowing flexibility in data schemas for rapid prototyping.
 *
 * @section Data Structure
 * - `/users/{userId}`: Root collection for user profiles and private subcollections.
 * - `/users/{userId}/redemptions`: Subcollection for a user's private redemption history.
 * - `/users/{userId}/invite_codes`: Subcollection for invite codes generated by a user.
 * - `/partners` & `/offers`: Top-level collections for business data, publicly readable.
 * - `/roles_admin/{uid}`: A dedicated collection to manage global administrator roles.
 * - `/roles_partner/{uid}`: A dedicated collection to manage global partner roles.
 *
 * @section Key Security Decisions
 * - Role Management: A user's role is determined by the existence of their UID in a role-specific collection (e.g., `/roles_admin/{uid}`).
 * - User Data Privacy: All data nested under `/users/{userId}` is private. Access is restricted to the document owner and admins.
 * - Public Data: `/partners` and `/offers` are publicly readable. Writes are restricted to admins or relevant partners.
 * - Immutable Ownership: Ownership fields (like `userId`) cannot be changed after creation.
 *
 * @section Denormalization for Authorization
 * Rules rely on denormalized data (e.g., `userId` in redemption documents) to avoid slow and costly `get()` calls in rules.
 *
 * @section Structural Segregation
 * User-specific data is in private subcollections. Public data is in top-level collections. Admin roles are in a dedicated collection. This separation allows for simple, performant, path-based security rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the requesting user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if the user is an admin by checking for their UID in the roles_admin collection.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    /**
     * Checks if the user is a partner by checking for their UID in the roles_partner collection.
     */
    function isPartner() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_partner/$(request.auth.uid));
    }

    /**
     * Validates that an ownership field is immutable during an update.
     */
    function isOwnerFieldImmutable(ownerIdField) {
      return request.resource.data[ownerIdField] == resource.data[ownerIdField];
    }
    
    /**
     * Validates the incoming offer data for create and update operations.
     */
    function isValidOfferData() {
        let data = request.resource.data;
        return data.partnerId == request.auth.uid &&
               data.title is string && data.title.size() > 0 &&
               data.description is string && data.description.size() > 0;
    }


    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    /**
     * @description Manages user profile documents.
     * - Admins can list all users.
     * - A user can read their own profile.
     * - A user can create their own profile.
     * - An admin or owner can update a profile.
     * - Only admins can delete profiles.
     */
    match /users/{userId} {
      allow list: if isAdmin();
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if (isOwner(userId) || isAdmin()) && isOwnerFieldImmutable('id');
      allow delete: if isAdmin();
    }

    /**
     * @description Manages partner location profiles. Publicly readable.
     * Only admins can manage partner documents.
     */
    match /partners/{partnerId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Manages offers from partners. Publicly readable.
     * Admins can manage all offers. Partners can manage their own offers.
     */
    match /offers/{offerId} {
      allow get: if true;
      allow list: if true;
      allow create: if (isAdmin() || isPartner()) && isValidOfferData();
      allow update: if isAdmin() || (isPartner() && isOwnerFieldImmutable('partnerId') && isValidOfferData());
      allow delete: if isAdmin() || (isPartner() && resource.data.partnerId == request.auth.uid);
    }

    /**
     * @description Manages a user's history of redeemed offers.
     * Private to the user, but accessible by admins. Partners can create redemptions on behalf of a user.
     */
    match /users/{userId}/redemptions/{redemptionId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) || isPartner()) && request.resource.data.userId == userId;
      allow update: if isAdmin() && isOwnerFieldImmutable('userId');
      allow delete: if isAdmin();
    }

    /**
     * @description Manages invite codes generated by a user.
     * Private to the user, but accessible by admins.
     */
    match /users/{userId}/invite_codes/{inviteCodeId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.inviterId == userId;
      allow update: if (isOwner(userId) || isAdmin()) && isOwnerFieldImmutable('inviterId');
      allow delete: if isAdmin();
    }

    /**
     * @description Manages administrator roles.
     * The existence of a document here grants admin privileges. Only other admins can manage these.
     */
    match /roles_admin/{userId} {
      allow read, write: if isAdmin();
    }

     /**
     * @description Manages partner roles.
     * The existence of a document here grants partner privileges. Only admins can manage these.
     */
    match /roles_partner/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
