rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    function isPartner() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_partner/$(request.auth.uid));
    }

    // -------------------------------------------------------------------------
    // User and Role Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Sub-collections for individual user access
      match /redemptions/{redemptionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
      }
    }
    
    match /users {
      // Admins can list all users
      allow list: if isAdmin();
      // A new user can only be created if they are providing a valid, available invite code.
      // The validation logic happens in the client, but the security rule ensures the write is allowed
      // for the new authenticated user.
      allow create: if isSignedIn() && request.resource.data.id == request.auth.uid;
    }

    // Allows admins to query across all users' redemptions for the dashboard
    match /{path=**}/redemptions/{redemptionId} {
      allow read: if isAdmin();
    }
    
    // -------------------------------------------------------------------------
    // Public and Partner-facing Collections
    // -------------------------------------------------------------------------

    match /partners/{partnerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow create: if isAdmin() || isPartner();
      allow update, delete: if isAdmin() || (isPartner() && resource.data.partnerId == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // Invite Code Rules
    // -------------------------------------------------------------------------
    match /invite_codes/{inviteCodeId} {
      // Allow reading a code for validation before sign-up (e.g., check status).
      allow get: if true; 
      // Allow a signed-in user to update a code (to redeem it).
      allow update: if isSignedIn();
      // Only admins or authenticated users with invites left can create new ones.
      allow create: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.inviteCodeCount > 0);
      // Only admins can list or delete codes.
      allow list, delete: if isAdmin();
    }
    
    // -------------------------------------------------------------------------
    // Role Management Rules
    // -------------------------------------------------------------------------

    match /roles_admin/{uid} {
      allow read, write: if isAdmin();
    }
    
    match /roles_partner/{uid} {
      allow read, write: if isAdmin();
    }
  }
}
