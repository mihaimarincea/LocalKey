rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    function isPartner() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_partner/$(request.auth.uid));
    }

    // -------------------------------------------------------------------------
    // User and Role Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Sub-collections for individual user access
      match /redemptions/{redemptionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
      }

      match /invite_codes/{inviteCodeId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.inviterId == userId;
        allow update: if isOwner(userId) || isAdmin();
      }
    }
    
    match /users {
      // Admins can list all users
      allow list: if isAdmin();
      // Any signed-in user can create their own user document
      allow create: if isSignedIn() && request.resource.data.id == request.auth.uid;
    }

    // Allows admins to query across all users' redemptions for the dashboard
    match /{path=**}/redemptions/{redemptionId} {
      allow read: if isAdmin();
    }
    
    // -------------------------------------------------------------------------
    // Public and Partner-facing Collections
    // -------------------------------------------------------------------------

    match /partners/{partnerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow create: if isAdmin() || isPartner();
      allow update, delete: if isAdmin() || (isPartner() && resource.data.partnerId == request.auth.uid);
    }
    
    // -------------------------------------------------------------------------
    // Role Management Rules
    // -------------------------------------------------------------------------

    match /roles_admin/{uid} {
      allow read, write: if isAdmin();
    }
    
    match /roles_partner/{uid} {
      allow read, write: if isAdmin();
    }
  }
}
