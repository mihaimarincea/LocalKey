/**
 * @file firestore.rules
 * @description Firestore Security Rules for the LocalKey application.
 *
 * @section Core Philosophy
 * This ruleset enforces a security model that strictly separates public business data from private user data.
 * It uses a combination of user ownership and a global admin role to control access. The primary goal is high security
 * and authorization integrity while allowing flexibility in data schemas for rapid prototyping.
 *
 * @section Data Structure
 * - `/users/{userId}`: Root collection for user profiles and private subcollections.
 * - `/users/{userId}/redemptions`: Subcollection for a user's private redemption history.
 * - `/users/{userId}/invite_codes`: Subcollection for invite codes generated by a user.
 * - `/partners` & `/offers`: Top-level collections for business data, publicly readable.
 *
 * @section Key Security Decisions
 * - Admin Role: A user is considered an admin if the `role` field on their `/users/{userId}` document is set to 'admin'. Admins have broad read/write access for management.
 * - User Data Privacy: All data nested under `/users/{userId}` is considered private. Access is restricted to the document owner and administrators.
 * - Public Data: The `/partners` and `/offers` collections are publicly readable by anyone to allow the app to display business information. Writes are restricted to admins.
 * - Immutable Ownership: Once a document is created with an ownership link (e.g., a `userId` or `inviterId` field), that link cannot be changed.
 *
 * @section Denormalization for Authorization
 * The rules are designed to be simple and performant by relying on denormalized data. For example, `redemption` documents within a user's subcollection also contain a `userId` field. This allows rules to validate ownership by checking both the document path and its internal data without requiring slow and costly `get()` calls to other documents.
 *
 * @section Structural Segregation
 * User-specific data (like redemptions) is stored in private subcollections under the user's document. Publicly-accessible data (like offers) is stored in separate top-level collections. This clear separation allows for simple, path-based security rules that are highly performant for list queries.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the requesting user's UID matches the provided userId.
     * This is the foundation of the ownership model.
     * @param userId The UID of the user to check for ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if the requesting user has admin privileges.
     * Admin status is granted if the user's document in the /users collection
     * has the 'role' field set to 'admin'.
     */
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    /**
     * Validates that an ownership field is immutable during an update operation.
     * This prevents re-assigning ownership of a document.
     * @param ownerIdField The name of the field containing the owner's UID.
     */
    function isOwnerFieldImmutable(ownerIdField) {
      return request.resource.data[ownerIdField] == resource.data[ownerIdField];
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    /**
     * @description Manages user profile documents.
     * @path /users/{userId}
     * @allow An admin can list all users. (list)
     * @deny A user (auth.uid='user456') attempts to read another user's profile at `/users/user123`. (get, list)
     * @principle Restricts access to a user's own data tree and prevents user enumeration by non-admins.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if (isOwner(userId) || isAdmin()) && resource != null && request.resource.data.id == resource.data.id;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages partner location profiles. This data is public.
     * @path /partners/{partnerId}
     * @allow Any user, signed-in or not, can read a list of all partners. (list)
     * @deny A regular signed-in user attempts to create a new partner document. (create)
     * @principle Public read access for general app data, with writes restricted to administrators.
     */
    match /partners/{partnerId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages offers from partners. This data is public.
     * @path /offers/{offerId}
     * @allow Any user, signed-in or not, can view a specific offer. (get)
     * @deny A regular signed-in user attempts to delete an offer. (delete)
     * @principle Public read access for general app data, with writes restricted to administrators.
     */
    match /offers/{offerId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages a user's history of redeemed offers.
     * @path /users/{userId}/redemptions/{redemptionId}
     * @allow A user (auth.uid='user123') creates a redemption record in their own subcollection. (create)
     * @deny A user (auth.uid='user456') tries to read the redemption history of another user. (get, list)
     * @principle Enforces strict data ownership within a user's private subcollection. Redemptions are immutable for users.
     */
    match /users/{userId}/redemptions/{redemptionId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isAdmin() && resource != null && isOwnerFieldImmutable('userId');
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages invite codes generated by a user.
     * @path /users/{userId}/invite_codes/{inviteCodeId}
     * @allow A user (auth.uid='user123') lists all invite codes they have generated. (list)
     * @deny A user (auth.uid='user456') tries to create an invite code under another user's path. (create)
     * @principle Enforces strict data ownership for user-generated content.
     */
    match /users/{userId}/invite_codes/{inviteCodeId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.inviterId == userId;
      allow update: if (isOwner(userId) || isAdmin()) && resource != null && isOwnerFieldImmutable('inviterId');
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description DEPRECATED. This collection is no longer used for admin checks.
     * Admin roles are now checked via the 'role' field on the user's document.
     */
    match /roles_admin/{userId} {
      allow read, write: if false;
    }
  }
}
