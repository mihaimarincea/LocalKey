rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    function isPartner() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_partner/$(request.auth.uid));
    }

    function isOwnerFieldImmutable(fieldName) {
      return resource == null || request.resource.data[fieldName] == resource.data[fieldName];
    }
    
    function isValidOfferData() {
      let data = request.resource.data;
      return data.partnerId is string &&
             data.title is string && data.title.size() > 0 &&
             data.description is string && data.description.size() > 0;
    }

    // -------------------------------------------------------------------------
    // User Collection Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      // Admins have full access to all user documents
      allow get, list, create, update, delete: if isAdmin();

      // Signed-in users can create their own document
      allow create: if isSignedIn() && request.resource.data.id == request.auth.uid;
      
      // Users can get and update their own document
      allow get, update: if isOwner(userId);

      // Sub-collection: redemptions
      match /redemptions/{redemptionId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isPartner()) && request.resource.data.userId == userId;
        allow update, delete: if isAdmin();
      }

      // Sub-collection: invite_codes
      match /invite_codes/{inviteCodeId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && request.resource.data.inviterId == userId;
        allow update, delete: if isAdmin();
      }
    }

    // -------------------------------------------------------------------------
    // Public and Partner-facing Collections
    // -------------------------------------------------------------------------

    match /partners/{partnerId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /offers/{offerId} {
      allow get, list: if true;
      allow create: if (isAdmin() || isPartner()) && isValidOfferData() && request.resource.data.partnerId == request.auth.uid;
      allow update: if (isAdmin() || (isPartner() && resource.data.partnerId == request.auth.uid)) && isValidOfferData() && isOwnerFieldImmutable('partnerId');
      allow delete: if isAdmin() || (isPartner() && resource.data.partnerId == request.auth.uid);
    }
    
    // -------------------------------------------------------------------------
    // Role Management Rules
    // -------------------------------------------------------------------------

    match /roles_admin/{uid} {
      allow read, write: if isAdmin();
    }
    
    match /roles_partner/{uid} {
      allow read, write: if isAdmin();
    }
  }
}
