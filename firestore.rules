rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    function isPartner() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_partner/$(request.auth.uid));
    }

    // -------------------------------------------------------------------------
    // User and Role Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      // Allow creation if the user is signing up.
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Sub-collections for individual user access
      match /redemptions/{redemptionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
      }
    }
    
    match /users {
      // Admins can list all users
      allow list: if isAdmin();
    }

    // Allows admins to query across all users' redemptions for the dashboard
    match /{path=**}/redemptions/{redemptionId} {
      allow read: if isAdmin();
    }
    
    // -------------------------------------------------------------------------
    // Public and Partner-facing Collections
    // -------------------------------------------------------------------------

    match /partners/{partnerId} {
      // A user can create a partner application for themselves upon signup.
      allow create: if isOwner(partnerId);
      // Only admins or the partner themselves can read the partner document.
      allow get: if isAdmin() || isOwner(partnerId);
      // Only admins can update (approve/reject), delete, or list partner applications.
      allow update, delete, list: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow create: if isAdmin() || isPartner();
      allow update, delete: if isAdmin() || (isPartner() && resource.data.partnerId == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // Invite Code Rules
    // -------------------------------------------------------------------------
    match /invite_codes/{inviteCodeId} {
      // Allow reading a code for validation before sign-up (e.g., check status).
      allow get: if true; 
      // Allow a signed-in user to update a code (to redeem it).
      allow update: if isSignedIn();
      // Only admins or authenticated users with invites left can create new ones.
      allow create: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.inviteCodeCount > 0);
      // Only admins can list or delete codes.
      allow list, delete: if isAdmin();
    }
    
    // -------------------------------------------------------------------------
    // Role Management Rules
    // -------------------------------------------------------------------------

    match /roles_admin/{uid} {
      allow read, write: if isAdmin();
    }
    
    match /roles_partner/{uid} {
      allow read, write: if isAdmin();
    }
  }
}
