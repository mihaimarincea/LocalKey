rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    function isPartner() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_partner/$(request.auth.uid));
    }

    // -------------------------------------------------------------------------
    // User Collection Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      // Admins can get any user document. Users can get their own.
      allow get: if isAdmin() || isOwner(userId);
      
      // Admins can update any user document. Users can update their own.
      allow update: if isAdmin() || isOwner(userId);
      
      // Only admins can delete user documents.
      allow delete: if isAdmin();

      // Sub-collections
      match /redemptions/{redemptionId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isPartner()) && request.resource.data.userId == userId;
        allow update, delete: if isAdmin();
      }

      match /invite_codes/{inviteCodeId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && request.resource.data.inviterId == userId;
        allow update, delete: if isAdmin();
      }
    }
    
    // This rule allows admins to list all users, which is needed for the admin user management page
    match /users/{document=**} {
        allow list, create: if isAdmin() || isSignedIn();
    }


    // -------------------------------------------------------------------------
    // Public and Partner-facing Collections
    // -------------------------------------------------------------------------

    match /partners/{partnerId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /offers/{offerId} {
      allow get, list: if true;
      allow create: if isAdmin() || isPartner();
      allow update, delete: if isAdmin() || (isPartner() && resource.data.partnerId == request.auth.uid);
    }
    
    // -------------------------------------------------------------------------
    // Role Management Rules
    // -------------------------------------------------------------------------

    match /roles_admin/{uid} {
      // Only other admins can see or edit who is an admin.
      allow read, write: if isAdmin();
    }
    
    match /roles_partner/{uid} {
      // Only admins can manage the partner role.
      allow read, write: if isAdmin();
    }
  }
}
